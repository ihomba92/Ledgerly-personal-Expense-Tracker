# Copy this file to .env and adjust the values. Never commit .env.
APP_ENV=development

# Long random string used to sign data. Generate one with:
#   pipenv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Separate long random string used to sign login tokens (JWT). Generate it the same way.
JWT_SECRET_KEY=change-me

# Resend (https://resend.com): leave empty in development and reset emails are
# printed in the terminal instead. onboarding@resend.dev only sends to your own
# Resend account email; verify your domain in Resend to send to anyone.
RESEND_API_KEY=
EMAIL_FROM=Ledgerly <onboarding@resend.dev>

# Optional: support messages are also emailed here.
SUPPORT_EMAIL=

# Where receipt files are saved (default: instance/uploads inside the project).
# UPLOAD_FOLDER=/var/ledgerly/uploads

# Where rate-limit counters are kept. memory:// is fine for development;
# use Redis in production, e.g. redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# The React app (Vite dev server). Requests from here are allowed.
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://ledgerly:ledgerly_dev_password@localhost:5432/ledgerly
TEST_DATABASE_URL=postgresql+psycopg://ledgerly:ledgerly_dev_password@localhost:5432/ledgerly_test

# Set to 1 in production when running behind a proxy or load balancer.
TRUST_PROXY=0

# ---------- Logging ----------
# LOG_LEVEL=INFO          DEBUG shows more detail
# LOG_FORMAT=text         json for log services in production
# LOG_FILE=logs/ledgerly.log   (leave empty to log to the console only)

# ---------- Sign in with Google / Microsoft (optional) ----------
# Each button appears only when its client id and secret are set. Redirect URIs to register:
#   http://localhost:8000/api/auth/oauth/google/callback
#   http://localhost:8000/api/auth/oauth/microsoft/callback
API_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
